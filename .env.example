# Database Configuration
POSTGRES_USER=cveuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cvewatcher

# Application Configuration
DATABASE_URL=postgresql://cveuser:change-me@db:5432/cvewatcher

# JWT Configuration
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# NIST NVD API (optional)
# A free API key raises the rate limit from 5 to 50 requests / 30s.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Cache NVD search results for this many seconds so repeated identical queries
# (e.g. re-opening an asset or changing the dashboard severity filter) are
# served without hitting the API. Set to 0 to disable.
NVD_CACHE_TTL_SECONDS=600

# Max concurrent NVD requests per lookup. Defaults to 3 without an API key
# (NVD allows 5 req/30s) and 10 with one. Raise it only if you have an API key.
# NVD_MAX_CONCURRENCY=3

# Development Settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Login rate limiting (best-effort, per process)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Periodic CVE monitoring (opt-in background scheduler)
MONITOR_ENABLED=false
MONITOR_INTERVAL_MINUTES=360

# Scheduled email digest of active findings (opt-in; needs NOTIFY_EMAIL_* and,
# in practice, MONITOR_ENABLED so findings are populated). Sent to each user's
# registered email.
DIGEST_ENABLED=false
DIGEST_INTERVAL_MINUTES=1440

# Threat-intelligence enrichment (CISA KEV flag + FIRST.org EPSS score)
# Set to false to skip the extra HTTP lookups.
ENRICH_ENABLED=true

# Notifications for newly discovered vulnerabilities
NOTIFY_CONSOLE=true
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/cvewatcher
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Email notifier (SMTP). All three of HOST, FROM and TO are required to enable it.
# NOTIFY_EMAIL_HOST=smtp.example.com
# NOTIFY_EMAIL_PORT=587
# NOTIFY_EMAIL_USE_TLS=true
# NOTIFY_EMAIL_USERNAME=cvewatcher@example.com
# NOTIFY_EMAIL_PASSWORD=change-me
# NOTIFY_EMAIL_FROM=cvewatcher@example.com
# NOTIFY_EMAIL_TO=security@example.com,ops@example.com

# Token revocation backend: set to use Redis instead of the database denylist
# REDIS_URL=redis://localhost:6379/0
